# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# local logs and generated artifacts
*.log
*-output.txt
lint-report.*
next-env.d.ts

.vercel

# Convex AI agent skills (installed by 'npx convex ai-files install')
.agents/skills/convex-*
.claude/skills/convex-*
convex/_generated/ai/

test-results/
